# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (ไฟล์ .env.local ไม่ถูก commit)
# ไม่ใส่ client id/secret ของผู้ให้บริการไหนเลย = ปิดระบบเข้าสู่ระบบจริง (หน้าบัญชีใช้แบบจำลอง · /editor เปิดได้เลย)

# กุญแจเข้ารหัส session · สร้างด้วย: npx auth secret  หรือ  openssl rand -base64 33
AUTH_SECRET=

# Google OAuth · https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (และ https://<โดเมนจริง>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (ไม่บังคับ) · https://github.com/settings/developers → New OAuth App
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ต้องมีเมื่อรันแบบ production (npm start) หรือ deploy เองนอก Vercel · npm run dev ไม่ต้อง
AUTH_TRUST_HOST=true
